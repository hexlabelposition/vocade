{
  "name": "vocade",
  "version": "1.0.0",
  "scripts": {
    "fetch-model": "bash scripts/fetch-model.sh",
    "dev": "vite",
    "dev:https": "HTTPS=1 vite",
    "build": "tsc && vite build",
    "typecheck": "tsc && tsc -p scripts/tsconfig.json",
    "preview": "vite preview --host",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types scripts/test-numbers.ts"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "private": true,
  "type": "module"
}
